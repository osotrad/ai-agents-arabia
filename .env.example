# --- Website runtime (Cloudflare Worker) ---
# Neon Postgres connection string (with pgvector enabled).
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Public site URL (used for canonical URLs, sitemap, RSS, IndexNow, revalidation).
SITE_URL=https://your-site.example.com

# Bearer token the external agent uses for /api/v1 and /api/mcp. Min 16 chars.
AGENT_API_KEY=change-me-to-a-long-random-string

# Human reviewer key for /api/admin/* and the /admin/review page. Min 16 chars.
ADMIN_API_KEY=change-me-to-a-different-long-random-string

# IndexNow key (optional). Enables fast indexing on Bing/Yandex.
INDEXNOW_KEY=optional-indexnow-key

# Max articles the agent may auto-publish per rolling 24h (default 5).
DAILY_PUBLISH_CAP=5
