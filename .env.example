# --- Website runtime (Cloudflare Worker) ---
# Neon Postgres connection string (with pgvector enabled).
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Public site URL (used for canonical URLs, sitemap, RSS, IndexNow, revalidation).
SITE_URL=https://your-site.example.com

# Bearer token the external agent uses for /api/v1 and /api/mcp. Min 16 chars.
AGENT_API_KEY=change-me-to-a-long-random-string

# Human reviewer key for /api/admin/* and the /admin/review page. Min 16 chars.
ADMIN_API_KEY=change-me-to-a-different-long-random-string

# IndexNow key (optional). Enables fast indexing on Bing/Yandex.
INDEXNOW_KEY=optional-indexnow-key

# Max articles the agent may auto-publish per rolling 24h (default 5).
DAILY_PUBLISH_CAP=5

# --- Neon Object Storage (beta) — article header images ---
# Leave unset to disable image uploads; the rest of the site is unaffected.
# `neon deploy` writes AWS_* values for the linked branch into .env.local.
# Endpoint is the branch S3 endpoint; path-style addressing is required.
NEON_STORAGE_ENDPOINT=https://<branch-id>.storage.<region>.neon.build
NEON_STORAGE_REGION=<region>
NEON_STORAGE_ACCESS_KEY_ID=<access-key>
NEON_STORAGE_SECRET_ACCESS_KEY=<secret-key>

# Bucket holding generated images. Must be public_read to be servable as <img>.
IMAGE_BUCKET=article-images

# Public origin serving IMAGE_BUCKET, if it has one. Falls back to the endpoint.
IMAGE_PUBLIC_BASE=

# Max bytes per image upload (default 5 MiB).
MAX_IMAGE_BYTES=5242880


